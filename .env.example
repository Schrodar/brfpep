# =============================================================================
# Miljövariabler för generisk BRF-sida  –  MALL (checkas in, inga hemligheter!)
# =============================================================================
# Kopiera relevanta rader till .env (DB) resp. .env.local (övrigt). Båda är
# gitignore:ade. Lägg ALDRIG riktiga lösenord/nycklar i den här filen.

# --- Bas (.env.local) --------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# E-post till styrelsen som felanmälningar och nya registreringar aviseras till.
ADMIN_NOTIFICATION_EMAIL="styrelsen@example.se"

# --- Databas / Prisma (.env) -------------------------------------------------
# Hämtas i Supabase: Connect → ORM (Prisma). Lägg dessa i .env (inte här).
#   DATABASE_URL = transaction pooler, port 6543, med ?pgbouncer=true  (runtime)
#   DIRECT_URL   = session pooler,     port 5432                        (migrate)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Multi-tenant (.env) -----------------------------------------------------
# Vilken förening denna deploy gäller (matchar Association.slug i den delade DB:n).
# En deploy per förening; samma databas. Skapa föreningen med:
#   npm run association:create -- <slug> "<namn>"
ASSOCIATION_SLUG="brf-exempelgarden"

# --- Supabase Auth (.env.local) ---------------------------------------------
# Settings → API. Anon-nyckeln är publik; service role-nyckeln är hemlig.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend / e-post (.env.local, kopplas in i nästa steg) ------------------
# RESEND_API_KEY=""
# EMAIL_FROM="BRF Exempel <no-reply@example.se>"

# --- Demodata (.env.local, bara för utveckling) ----------------------------
# Lösenord för demokontona som scripts/seed-demo-tenants.ts skapar.
# Sätts bara lokalt – kontona finns på riktigt i Supabase Auth.
# DEMO_PASSWORD=""

# --- Hero-film (valfri) ----------------------------------------------------
# Bakgrundsfilmen i heron på startsidan ligger inte i repot: den är
# föreningens egen eller licensierad. Lägg filen i public/videos/ och peka ut
# den här, eller ange en adress till en CDN. Tom = ingen film, heron visar
# sin mörka bakgrund i stället.
# NEXT_PUBLIC_HERO_VIDEO="/videos/hero.mp4"
