// ⚠ KOPIA – schemat ägs av BrfStart (github.com/Schrodar/BrfStart).
//
// Kör ALDRIG prisma db push eller prisma migrate härifrån mot den delade
// Supabase-databasen: den delas med alla föreningar, och ett äldre schema kan
// radera kolumner där. Ändringar görs i BrfStart och förs sedan över hit.
//
// Demon (Brf Pep) har en egen databas (Postgres i Coolify, se README "Demons
// databas"). Lägg in schemaändringar där med `npm run demo:db:push`, som
// vägrar köra om DATABASE_URL pekar på Supabase. Demodatabasen har ingen
// pooler: url och directUrl är samma adress.

// Datamodell för generisk BRF-sida (multi-tenant).
//
// Databas: Supabase Postgres (delad mellan flera föreningar).
//   url       -> transaction pooler (port 6543, ?pgbouncer=true) för runtime
//   directUrl -> session pooler (port 5432) för prisma migrate/db push
//
// MULTI-TENANT: varje förening är en Association (tenant). Alla tenant-tabeller
// har associationId. Vilken förening en deploy gäller styrs av ASSOCIATION_SLUG
// (env). Isoleringen sköts av en auto-scopad Prisma-klient (src/lib/tenant.ts).

generator client {
  provider      = "prisma-client-js"
  // native för den egna datorn, debian-openssl-3.0.x för Docker-imagen
  // (node:22-bookworm-slim, se Dockerfile). Bygget i Docker genererar klienten
  // på samma plattform som den kör på, men målet skrivs ut så att det inte
  // beror på var `prisma generate` råkar köras.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums (värden matchar string-unionerna i src/lib/types.ts exakt)
// ---------------------------------------------------------------------------

enum Role {
  admin
  member
}

enum MemberStatus {
  pending
  approved
  rejected
}

enum DocumentCategory {
  stadgar
  arsredovisning
  protokoll
  ordningsregler
  ovrigt
}

enum DocumentVisibility {
  public
  member
  /// Bara styrelsen (godkänd admin), t.ex. justerade styrelseprotokoll.
  /// Syns aldrig på medlemmarnas dokumentsida.
  board
}

enum MaintenanceStatus {
  ny
  pagar
  /// Väntar på offert, leverantör eller material. Lades till efter de andra –
  /// ordningen i flödet styrs av MAINTENANCE_STATUSES, inte av enumen.
  vantar
  atgardad
}

/// Vad en händelse i ett ärendes historik är.
enum MaintenanceEventKind {
  /// Intern notering – syns bara för styrelsen.
  note
  /// Svar till medlemmen – syns alltid på Mina sidor.
  reply
  /// Styrelsens beslut. Syns för medlemmen bara om visibleToMember är satt.
  decision
}

enum ListingStatus {
  draft
  published
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

/// En förening (tenant). slug matchar ASSOCIATION_SLUG i deployens env.
///
/// Raden bär också föreningens identitet – namn, adress och kontaktuppgifter –
/// som visas i header, footer och på kontaktsidorna. Styrelsen redigerar dem
/// under Admin → Föreningsinfo → Namn och kontakt. Tom sträng = visas inte.
/// Webbens logotyp och färger hör till själva deployen och ligger kvar i
/// koden. brandColor och logoPath används av styrelseappen, som är en och
/// samma app för alla föreningar.
model Association {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  /// Kortnamn för header, meny och sidtitlar. Tomt = samma som name.
  shortName            String @default("")
  organizationNumber   String @default("")
  street               String @default("")
  postalCode           String @default("")
  city                 String @default("")
  /// Styrelsens publika kontaktuppgifter.
  contactEmail         String @default("")
  contactPhone         String @default("")
  /// Förvaltaren. Allt tomt döljer förvaltarrutorna.
  propertyManagerName  String @default("")
  propertyManagerPhone String @default("")
  propertyManagerEmail String @default("")

  /// Föreningens färg i styrelseappen, hex som "#315c4a". Tom = appens
  /// standardfärg.
  brandColor String  @default("")
  /// Logotyp i styrelseappen, i den publika bucketen news-images:
  /// <associationId>/profil/<uuid>.<ext>. Null = appen visar initialerna.
  logoPath   String?

  members               Member[]
  news                  NewsPost[]
  board                 BoardMember[]
  boardGroups           BoardGroup[]
  documents             Document[]
  maintenance           MaintenanceRequest[]
  maintenanceEvents     MaintenanceEvent[]
  maintenanceCategories MaintenanceCategory[]
  maintenanceSettings   MaintenanceSettings?
  apartments            Apartment[]
  buildings             Building[]
  photos                ApartmentPhoto[]
  siteContent           SiteContent?
  info                  AssociationInfo?
  economy               EconomyFigures?
  platformAccount       PlatformAccount?
  supportSessions       SupportSession[]
  invitations           MemberInvitation[]
  displays              Display[]
  notices               Notice[]
  displaySettings       DisplaySettings?
  boardMatters          BoardMatter[]
  boardMatterEntries    BoardMatterEntry[]
  meetings              Meeting[]
  meetingAttendees      MeetingAttendee[]
  agendaItems           AgendaItem[]
  protocolSignatures    ProtocolSignature[]
  contacts              Contact[]
  contactCategories     ContactCategory[]
  deviceTokens          DeviceToken[]
}

// ---------------------------------------------------------------------------
// Plattform – ägarens panel över alla föreningar
// ---------------------------------------------------------------------------
//
// Modellerna nedan tillhör plattformspanelen (eget privat repo). Föreningssajten
// rör bara SupportSession och MemberInvitation, och då enbart för att lösa in
// panelens engångslänkar. De ligger ändå i den här filen, eftersom
// `prisma db push` utgår härifrån och skulle radera tabeller som saknas.

/// Ägaren av plattformen – inte en förenings styrelse.
model PlatformAdmin {
  id         String    @id @default(uuid())
  /// Supabase Auth-användarens id. Kopplingen är id:t och inte e-posten, som kan bytas.
  userId     String    @unique
  email      String
  name       String    @default("")
  createdAt  DateTime  @default(now())
  disabledAt DateTime?

  supportSessions SupportSession[]
  invitations     MemberInvitation[]
  auditEvents     AuditEvent[]
}

/// Kunduppgifter per förening. Läses bara av panelen.
model PlatformAccount {
  id            String      @id @default(uuid())
  associationId String      @unique
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// demo | aktiv | pausad | avslutad
  status       String    @default("demo")
  startedAt    DateTime?
  billingEmail String    @default("")
  contactName  String    @default("")
  notes        String    @default("")
  updatedAt    DateTime  @updatedAt
}

/// Tidsbegränsad åtkomst till EN förenings adminpanel. Skapas i panelen och
/// löses in av /admin/support i den här appen.
///
/// Hemligheterna lagras bara som sha256 och är två skilda slumptal: tokenHash
/// hör till engångslänken, cookieHash till sessionens cookie. Cookiens hemlighet
/// skapas först vid inlösen, så en databasdump ger ingen åtkomst.
model SupportSession {
  id              String        @id @default(uuid())
  associationId   String
  association     Association   @relation(fields: [associationId], references: [id], onDelete: Cascade)
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  /// Denormaliserat, så att föreningssajten aldrig behöver läsa PlatformAdmin.
  adminName  String
  adminEmail String
  /// Varför sessionen öppnades – styrelsens kvitto och den dokumenterade instruktionen.
  reason     String

  tokenHash  String  @unique
  /// Null tills länken lösts in. Null krockar inte i ett unikt index.
  cookieHash String? @unique

  /// Länken är engångs och kortlivad; själva sessionen lever längre.
  linkExpiresAt DateTime
  usedAt        DateTime?
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  endedAt       DateTime?

  @@index([associationId, expiresAt])
}

/// Inbjudan till en förening, skapad i JnM-panelen eller av styrelsen och
/// inlöst av /aktivera i den här appen. Ger ingen åtkomst i sig: Member-raden
/// skapas först vid inlösen, när personen har valt eller bekräftat sitt lösenord.
///
/// Bara sha256 av länkens token lagras. Länken är engångs och tidsbegränsad.
model MemberInvitation {
  id              String         @id @default(uuid())
  associationId   String
  association     Association    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)

  /// Alltid gemener – Supabase Auth lagrar e-post så.
  email            String
  fullName         String
  apartment        String  @default("")
  role             Role
  canManageListing Boolean @default(false)

  /// Får inlösen byta lösenord på ett befintligt konto? Bara inbjudningar från
  /// plattformsägaren (JnM-panelen, invite-admin.ts). Styrelsens inbjudningar
  /// kräver i stället kontots befintliga lösenord – annars kunde en styrelse
  /// bjuda in vilken adress som helst och ta över kontot.
  resetsPassword Boolean @default(false)
  /// Visningsnamn för den som bjöd in, t.ex. "JnM" eller styrelseledamotens namn.
  invitedBy      String  @default("")

  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  /// När JnM-panelen mejlade länken. Null = länken har bara kopierats.
  emailedAt DateTime?

  @@index([associationId, createdAt])
}

/// Loggbok över plattformsadmins åtgärder. associationId är avsiktligt ingen
/// främmande nyckel: loggen ska överleva att en förening tas bort.
model AuditEvent {
  id              String         @id @default(uuid())
  at              DateTime       @default(now())
  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  actorEmail      String
  associationId   String?
  action          String
  target          String         @default("")
  summary         String         @default("")

  @@index([associationId, at])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Tenant-tabeller (alla har associationId)
// ---------------------------------------------------------------------------

/// Boende eller styrelseledamot. Kopplas till Supabase Auth-användare via e-post.
model Member {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  email     String
  fullName  String
  apartment String       @default("")
  role      Role         @default(member)
  status    MemberStatus @default(pending)
  createdAt DateTime     @default(now())

  /// Behörighet att lägga upp/hantera en säljannons för sin lägenhet.
  canManageListing Boolean @default(false)

  ownedApartment Apartment?

  /// Felanmälningar medlemmen gjort inloggad.
  maintenanceRequests MaintenanceRequest[]

  /// Styrelsearbetet. Alla pekar tillbaka med SetNull utom push-token:
  /// protokoll och loggar sparar namnet som text och överlever att medlemmen
  /// tas bort.
  boardPositions     BoardMember[]
  ownedMatters       BoardMatter[]       @relation("BoardMatterOwner")
  matterEntries      BoardMatterEntry[]
  secretaryOf        Meeting[]           @relation("MeetingSecretary")
  meetingAttendances MeetingAttendee[]
  responsibleFor     AgendaItem[]        @relation("AgendaItemResponsible")
  writtenAgendaItems AgendaItem[]        @relation("AgendaItemWriter")
  protocolSignatures ProtocolSignature[]
  deviceTokens       DeviceToken[]

  @@unique([associationId, email])
  @@index([associationId])
  @@index([status])
}

/// Nyhet / aktuellt-inlägg.
model NewsPost {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  slug        String
  title       String
  excerpt     String
  body        String
  published   Boolean   @default(false)
  publishedAt DateTime?
  /// Sökväg i den publika bucketen "news-images": <newsId>/<uuid>.<ext>.
  /// Null = ingen bild (listan visar en platshållare).
  imagePath   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([associationId, slug])
  @@index([associationId, published, publishedAt])
}

/// En grupp på styrelsesidan, t.ex. "Styrelsen", "Valberedning",
/// "Trädgårdsgruppen". Var tidigare en enum; föreningen skapar egna grupper.
model BoardGroup {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  members BoardMember[]

  @@unique([associationId, name])
  @@index([associationId, sortOrder])
}

/// Person i en grupp på styrelsesidan.
model BoardMember {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Restrict, inte Cascade: att ta bort en grupp får aldrig tyst radera
  /// personerna i den. Datalagret vägrar och ber admin flytta dem först.
  groupId String
  group   BoardGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  role      String
  name      String
  email     String @default("")
  sortOrder Int    @default(0)

  /// Kontot bakom personen, om hen har ett. Så vet styrelseappen vem som är
  /// ordförande, kassör osv. SetNull: personen står kvar på styrelsesidan om
  /// medlemmen tas bort.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([associationId, groupId, sortOrder])
  @@index([associationId, memberId])
}

/// Dokument (PDF m.m.).
model Document {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  title      String
  category   DocumentCategory
  visibility DocumentVisibility @default(public)

  /// Härleds ur den uppladdade filen – aldrig inmatat för hand.
  fileName    String
  /// Sökväg i den privata bucketen "documents": <associationId>/<kategori>/<uuid>.<ext>
  /// Tom sträng = ingen fil uppladdad (demorader från seed).
  storagePath String @default("")
  mimeType    String @default("")
  sizeBytes   Int    @default(0)

  uploadedAt DateTime @default(now())

  /// Mötet dokumentet hör till, t.ex. det justerade protokollet. SetNull:
  /// dokumentet ligger kvar i arkivet om mötet tas bort.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([associationId, visibility])
  @@index([associationId, meetingId])
}

/// Kategori för felanmälan, t.ex. "VVS / vatten". Var tidigare en enum;
/// styrelsen lägger till egna (garage, sopsortering, laddstolpar …).
model MaintenanceCategory {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// Underleverantör som normalt hanterar den här typen av fel. Tomma fält
  /// döljer motsvarande rad i adminvyn; inget av detta visas publikt.
  ///
  /// På väg bort: ersätts av kontaktregistret (Contact via ContactCategory).
  /// Flyttas med `npm run contacts:migrate` när adminvyn bytt till registret,
  /// och tas bort ur schemat först när inget läser fälten längre.
  contractorName  String @default("")
  contractorPhone String @default("")
  contractorEmail String @default("")
  contractorInfo  String @default("")

  requests MaintenanceRequest[]
  contacts ContactCategory[]

  @@unique([associationId, name])
  @@index([associationId, sortOrder])
}

/// Redigerbara texter och kontaktuppgifter på felanmälningssidan.
/// En rad per förening. Tomt telefonnummer = rutan visas inte alls.
model MaintenanceSettings {
  id            String      @id @default(uuid())
  associationId String      @unique
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Förklaring högst upp: vad som är föreningens ansvar och vad som är den
  /// boendes eget.
  introText String

  /// Jour vid akuta fel. Tom telefon döljer rutan.
  emergencyPhone String @default("")
  emergencyText  String @default("")

  /// Fastighetsskötare – en tjänst utanför styrelsen som normalt kostar pengar.
  /// Tom telefon döljer rutan.
  caretakerName  String @default("")
  caretakerPhone String @default("")
  caretakerText  String @default("")
}

/// En händelse i ett ärendes historik: en notering, en statusändring eller
/// båda. Raderna skrivs bara till – en sparad notering ändras aldrig i
/// efterhand, så loggen går att lita på.
model MaintenanceEvent {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Fritext. Tom när händelsen bara är en statusändring.
  body       String             @default("")
  /// Gamla rader blir interna noteringar – de skrevs med texten "Syns bara
  /// för styrelsen".
  kind            MaintenanceEventKind @default(note)
  /// Visas texten för medlemmen på Mina sidor? Alltid för svar, aldrig för
  /// noteringar, och för beslut när styrelsen kryssat i det.
  visibleToMember Boolean              @default(false)
  /// Satta när status ändrades i samma sparning.
  statusFrom MaintenanceStatus?
  statusTo   MaintenanceStatus?
  /// Namnet på den i styrelsen som skrev. Sparas som text så att raden
  /// överlever att medlemmen tas bort.
  author     String             @default("")

  createdAt DateTime @default(now())

  @@index([associationId, requestId, createdAt])
}

/// Felanmälan från boende/besökare.
model MaintenanceRequest {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Restrict: en kategori med ärenden i får inte raderas, då skulle ärendena
  /// tappa sin kategori utan att någon bett om det.
  categoryId String
  category   MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Valfritt – anmälaren behöver inte uppge namn.
  name        String            @default("")
  /// Minst en av email/phone krävs; validering sker i server action.
  email       String            @default("")
  phone       String            @default("")
  location    String
  description String
  status      MaintenanceStatus @default(ny)
  createdAt   DateTime          @default(now())

  /// Löpnummer per förening (#14), att hänvisa till i protokoll och samtal.
  /// Null bara för ärenden från före numreringen, tills de numrerats.
  number Int?

  /// Vem som ska utföra jobbet. Nuvarande läge, inte historik.
  assignedTo String @default("")

  /// Kontakten i registret som fått jobbet, om den valts därifrån. assignedTo
  /// är fortfarande texten som visas, så att webben fungerar som förut.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Används inte längre (uppföljningsdatumet togs bort ur admin, ingen
  /// påminnelse skickades). Kvar så att ingen db push behövs; kan tas bort.
  followUpAt DateTime?

  /// Medlemmen som anmälde, om hen var inloggad. Sätts från sessionen, aldrig
  /// från formuläret. Styr märket på Mina sidor och vem som aviseras när
  /// status ändras. SetNull: ärendet finns kvar för styrelsen om medlemmen
  /// tas bort.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  /// När medlemmen senast såg sina ärenden. En statusändring efter det är en
  /// ny uppdatering för medlemmen.
  memberSeenAt DateTime?

  events       MaintenanceEvent[]
  boardMatters BoardMatter[]
  agendaItems  AgendaItem[]

  @@unique([associationId, number])
  @@index([associationId, status])
  @@index([associationId, memberId])
  @@index([associationId, followUpAt])
}

/// Redigerbart sidinnehåll (startsida + Om föreningen). En rad per förening.
model SiteContent {
  id            String      @id @default(uuid())
  associationId String      @unique
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  heroTitle    String
  heroSubtitle String
  welcomeBody  String
  aboutBody    String
}

/// Föreningsfakta (Om föreningen + mäklarsida). En rad per förening.
model AssociationInfo {
  id            String      @id @default(uuid())
  associationId String      @unique
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  builtYear          Int
  apartments         Int
  associationType    String
  landOwnership      String
  heating            String
  broadband          String
  parking            String
  laundry            String
  commonAreas        String
  feesInfo           String
  economySummary     String
  renovationsDone    String[]
  renovationsPlanned String[]
  pets               String
  energyClass        String
}

/// Underlaget för nyckeltalen på /ekonomi. En rad per förening.
///
/// Bara underlaget sparas – nyckeltalen räknas fram vid visning
/// (src/lib/key-figures.ts), så att ett publicerat tal aldrig kan glida isär
/// från siffrorna det bygger på. null = inte ifyllt. 0 är ett giltigt värde:
/// en skuldfri förening har 0 kr i räntebärande skulder.
model EconomyFigures {
  id            String      @id @default(uuid())
  associationId String      @unique
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Vilket år siffrorna gäller, t.ex. "2025" eller "2024/2025".
  fiscalYear String @default("")

  /// Totala årsavgifter per år, kr.
  annualFees          Float?
  /// Yta upplåten med bostadsrätt, m².
  condoArea           Float?
  /// Räntebärande skulder på balansdagen, kr.
  interestBearingDebt Float?
  /// Totalyta – bostadsrätt + hyresrätt (lokaler, garage …), m².
  totalArea           Float?
  /// Årets resultat, kr. Kan vara negativt.
  netResult           Float?
  /// Årets avskrivningar, kr.
  depreciation        Float?
  /// Kostnadsfört planerat underhåll, kr.
  plannedMaintenance  Float?
  /// Utrangeringar, kr. Valfritt.
  disposals           Float?
  /// Väsentliga engångsposter: kostnader positiva, intäkter negativa. Valfritt.
  nonRecurring        Float?

  /// Lägenheterna som bostadsrättsytan räknades fram ur: [{ label, sqm }].
  /// Tom lista = ytan skrevs in direkt.
  apartmentAreas Json @default("[]")

  updatedAt DateTime @updatedAt
}

/// Ett hus / trapphus i föreningen. Namnet är fritt: "Hus 43", "Trapphus B"
/// eller en adress fungerar lika bra.
model Building {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  name      String
  address   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// Förslag vid massinläggning: första FÖRENINGSNUMRET för husets lägenheter
  /// (Lantmäteriets nummer räknas fram ur våningsplanet och behöver inget
  /// startvärde). numberTopDown = översta våningen får de lägsta numren.
  numberStart   String  @default("1")
  numberTopDown Boolean @default(false)

  apartments Apartment[]
  displays   Display[]
  notices    Notice[]

  @@unique([associationId, name])
  @@index([associationId, sortOrder])
}

/// En lägenhet – nav mellan boende, planritning och säljannons.
model Apartment {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Föreningens eget lägenhetsnummer, t.ex. "23". Unikt per förening och det
  /// som kopplar en boende till sin lägenhet.
  number         String
  /// Lantmäteriets nummer, t.ex. "1101": två siffror för våningsplan (entré =
  /// 10, nedåt 09, 08 …) och två för lägenheten på planet. Visas som "23/1101".
  standardNumber String  @default("")
  ownerMemberId  String? @unique
  owner          Member? @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)

  /// Valfri: en lägenhet kan sakna hus (t.ex. en som skapats automatiskt när en
  /// boende loggat in). Den hamnar då under "Ej placerade" i registret.
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  // Fakta
  floor       String @default("")
  rooms       String @default("")
  sizeSqm     String @default("")
  description String @default("")

  // Planritning (privat fil i floor-plans-bucketen)
  floorPlanPath String?

  // Säljannons
  forSale               Boolean       @default(false)
  listingStatus         ListingStatus @default(draft)
  price                 String        @default("")
  monthlyFee            String        @default("")
  viewingInfo           String        @default("")
  saleDescription       String        @default("")
  brokerName            String        @default("")
  brokerPhone           String        @default("")
  brokerEmail           String        @default("")
  hemnetUrl             String        @default("")
  showFloorPlanPublicly Boolean       @default(false)
  publishedAt           DateTime?
  /// Den boende har skickat utkastet till styrelsen för publicering. Nollställs
  /// när annonsen publiceras eller den boende tar tillbaka den.
  submittedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos ApartmentPhoto[]

  @@unique([associationId, number])
  @@index([associationId, buildingId, number])
  @@index([associationId, forSale, listingStatus])
}

/// Annonsfoto (publik fil i apartment-photos-bucketen).
model ApartmentPhoto {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  path        String
  caption     String    @default("")
  sortOrder   Int       @default(0)

  @@index([apartmentId, sortOrder])
}

// ---------------------------------------------------------------------------
// Trapphustavlor – informationsskärmar i trapphusen
// ---------------------------------------------------------------------------

/// En skärm i ett trapphus. Skärmen visar /tavla/<token> i en låst webbläsare
/// och hämtar sitt innehåll från /api/tavla. Bara tokenens sha256 sparas –
/// adressen visas en gång när skärmen skapas (eller får ny token).
model Display {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  name       String
  /// Huset skärmen sitter i. Styr husets adress och vilka anslag som visas.
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  tokenHash  String    @unique
  revokedAt  DateTime?
  /// Senaste hämtningen. Uppdateras högst var femte minut.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([associationId])
}

/// Ett anslag på trapphustavlorna. Visas från startsAt till endsAt (tomt =
/// tills vidare), i alla hus eller bara i ett.
model Notice {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  title      String
  body       String
  /// Bild i news-images-bucketen (publik), under prefixet <associationId>/anslag.
  imagePath  String?
  startsAt   DateTime  @default(now())
  endsAt     DateTime?
  /// Tomt = alla hus.
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  /// Fästa anslag visas först.
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([associationId, startsAt])
}

/// Gemensamma inställningar för föreningens tavlor. Saknas raden gäller
/// standardvärdena.
model DisplaySettings {
  id            String      @id @default(uuid())
  associationId String      @unique
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Visa de senaste nyheterna från sajten under anslagen.
  showNews       Boolean @default(true)
  /// Svart skärm nattetid, "HH:MM". Lika värden = alltid på.
  nightStart     String  @default("23:00")
  nightEnd       String  @default("06:00")
  /// Hur ofta skärmarna hämtar nytt innehåll, i minuter: 60 eller 1440 (en
  /// gång om dagen). Glest med flit – skärmarna ska inte belasta servern,
  /// och innehållet ändras sällan.
  refreshMinutes Int     @default(1440)
}

// ---------------------------------------------------------------------------
// Styrelsearbete – ärenden, möten, protokoll och kontakter
// ---------------------------------------------------------------------------
//
// Används av BrfApi (Schrodar/BrfApp). Styrelseappen och hemsidans admin går
// båda via API:t, så reglerna – sekreterarens skrivrätt, paragrafernas
// versioner, justeringen – finns på ett ställe. Webbens sidor för detta
// anropar API:t i stället för att läsa tabellerna själva, och enumerna här
// har därför inga motsvarande unioner i src/lib/types.ts.
//
// Personer pekas ut med medlemmens id OCH namnet som text. Id:t är SetNull,
// så protokoll och loggar finns kvar, med namnet, om medlemmen tas bort.
//
// Relationerna mellan tabellerna är Cascade eller SetNull, aldrig Restrict,
// så att en förening kan tas bort i ett svep (scripts/delete-association.ts).
// Att ett justerat protokoll inte får raderas avgörs i BrfApi.

/// Var ett ärende står.
enum BoardMatterStatus {
  oppen
  /// Väntar på någon utanför styrelsen: offert, leverantör, besked.
  vantar
  klar
}

/// Vad en post i ett ärendes logg är.
enum BoardMatterEntryKind {
  /// Vad som gjorts eller hänt.
  logg
  /// En kostnad, med beloppet i amountKr.
  kostnad
  /// Förslag till beslut inför ett möte.
  beslutsforslag
  /// Beslut från ett möte. Skrivs när protokollet låses.
  beslut
}

enum MeetingType {
  ordinarie
  /// Första mötet efter stämman, där styrelsen fördelar uppdragen.
  konstituerande
  extra
  /// Beslut utan sammanträde, t.ex. via mejl. Protokollförs som ett möte.
  per_capsulam
}

/// Mötets gång. Ordningen i flödet styrs av BrfApi, inte av enumen.
enum MeetingStatus {
  /// Inplanerat. Dagordningen kan förberedas.
  planerat
  /// Mötet är öppnat. Protokollet skrivs, under mötet och efteråt.
  pagar
  /// Skickat för justering. Protokollet går inte att ändra.
  justering
  /// Justerat. PDF:en ligger i dokumentarkivet.
  last
  /// Mötet hölls aldrig.
  installt
}

/// Uppdrag på ett möte. ProtocolSignature.role använder samma värden.
enum MeetingRole {
  ordforande
  sekreterare
  justerare
}

/// Vad en punkt på dagordningen är.
enum AgendaItemKind {
  /// Fasta punkter: öppnande, val, dagordning, föregående protokoll, avslutning.
  fast
  /// Ett ärende från styrelsens logg (matterId).
  arende
  /// Felanmälningarna – översikten, eller en enskild via maintenanceRequestId.
  felanmalan
  /// Övriga punkter med egen rubrik.
  punkt
}

/// Hur ett protokoll justerades.
enum SignatureMethod {
  /// Engångskod via mejl eller SMS, i appen.
  otp
  bankid
  freja
  /// Underskrivet på papper och inskannat.
  papper
}

/// Vilken sorts kontakt det är. Styr grupperingen i appen.
enum ContactType {
  /// Underleverantör eller hantverkare: VVS, el, hiss, lås …
  leverantor
  /// Förvaltare och fastighetsskötsel.
  forvaltning
  /// Jour för akuta fel.
  jour
  /// Allt annat: revisor, försäkring, bank, kommun.
  ovrigt
}

enum DevicePlatform {
  ios
  android
}

/// Ett ärende som styrelsen arbetar med mellan mötena, t.ex. "Nya
/// tvättmaskiner" eller "Offert på takomläggning". Arbetet loggas i
/// BoardMatterEntry och tas upp på mötena.
model BoardMatter {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Löpnummer per förening, att hänvisa till i protokoll och samtal.
  number      Int
  title       String
  /// Bakgrunden i korthet. Det som händer sedan skrivs i loggen.
  description String            @default("")
  status      BoardMatterStatus @default(oppen)

  /// Den i styrelsen som driver ärendet.
  ownerMemberId String?
  owner         Member? @relation("BoardMatterOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  /// Ska tas upp på nästa möte. Ärendet hamnar då på dagordningen när den
  /// skapas, och flaggan nollställs när protokollet låses.
  nextMeeting Boolean @default(false)

  /// Felanmälan som ärendet växte ur, om någon.
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  /// Kontakten som ärendet främst gäller, t.ex. leverantören.
  contactId            String?
  contact              Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  entries     BoardMatterEntry[]
  agendaItems AgendaItem[]

  @@unique([associationId, number])
  @@index([associationId, status])
  @@index([associationId, nextMeeting])
}

/// En post i ett ärendes logg. Raderna skrivs bara till – en sparad post
/// ändras aldrig i efterhand, så loggen går att lita på som underlag till
/// protokollet.
model BoardMatterEntry {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  matterId String
  matter   BoardMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  kind        BoardMatterEntryKind @default(logg)
  body        String               @default("")
  /// Belopp i hela kronor, för kind = kostnad.
  amountKr    Int?
  /// Bilagor (foton, offerter) i den privata bucketen documents, under
  /// <associationId>/arenden/<matterId>/. En lista med
  /// { path, fileName, mimeType, sizeBytes }.
  attachments Json                 @default("[]")

  authorMemberId String?
  author         Member? @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)
  authorName     String

  /// Mötet där beslutet fattades, för kind = beslut.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([associationId, matterId, createdAt])
}

/// Ett styrelsemöte. Protokollet är mötets punkter (AgendaItem). Det skrivs på
/// datorn via hemsidans admin, och när det är justerat sparas det som PDF i
/// dokumentarkivet (Document.meetingId, synlighet board).
model Meeting {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  type     MeetingType   @default(ordinarie)
  status   MeetingStatus @default(planerat)
  startsAt DateTime
  location String        @default("")

  /// Protokollets nummer, t.ex. 2026:3 (år och löpnummer). Sätts när mötet
  /// öppnas, så att inställda möten inte lämnar hål i numreringen.
  year   Int?
  number Int?

  /// Klockslagen i protokollet: när mötet öppnades och avslutades.
  openedAt DateTime?
  closedAt DateTime?

  /// Den som skriver protokollet just nu och har skrivrätt. Byts med "Byt
  /// sekreterare". Den som skrivit tidigare står kvar som sekreterare i
  /// MeetingAttendee.roles och kallas också till justering.
  secretaryMemberId String?
  secretary         Member? @relation("MeetingSecretary", fields: [secretaryMemberId], references: [id], onDelete: SetNull)

  /// När kallelsen skickades.
  noticeSentAt     DateTime?
  /// PDF:en som skickades för justering: sökväg i den privata bucketen
  /// documents och dess sha256. Varje justering gäller just den filen.
  protocolPath     String?
  protocolSha256   String?
  sentForSigningAt DateTime?
  lockedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees   MeetingAttendee[]
  agendaItems AgendaItem[]
  signatures  ProtocolSignature[]
  documents   Document[]
  decisions   BoardMatterEntry[]

  @@unique([associationId, year, number])
  @@index([associationId, startsAt])
  @@index([associationId, status])
}

/// En deltagare: ledamot, suppleant eller adjungerad (t.ex. förvaltaren).
/// Närvaron kan ändras under mötet. Protokollet får då en rad vid den
/// aktuella punkten (AgendaItem.autoNotes), så att beslutsförheten framgår.
model MeetingAttendee {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// Null för gäster utan konto. Namnet sparas alltid som text.
  memberId  String?
  member    Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  name      String
  /// Uppdraget i föreningen: "Ordförande", "Ledamot", "Suppleant", "Förvaltare" …
  boardRole String  @default("")

  present   Boolean       @default(false)
  arrivedAt DateTime?
  leftAt    DateTime?
  /// Uppdrag på just det här mötet. Har sekreteraren bytts har båda kvar
  /// sekreterare.
  roles     MeetingRole[] @default([])

  @@unique([meetingId, memberId])
  @@index([associationId, meetingId])
}

/// En punkt på dagordningen, och i protokollet en paragraf. Paragrafnumret är
/// punktens plats i ordningen.
///
/// Bara mötets sekreterare får skriva. Varje sparning skickar med version och
/// avvisas om den inte stämmer, så att två datorer aldrig skriver över
/// varandra.
model AgendaItem {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  sortOrder Int
  kind      AgendaItemKind @default(punkt)
  title     String

  /// Underlaget: ärendet eller felanmälan som punkten gäller.
  matterId             String?
  matter               BoardMatter?        @relation(fields: [matterId], references: [id], onDelete: SetNull)
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)

  /// Protokolltexten.
  discussion          String    @default("")
  decision            String    @default("")
  /// Vem som ska göra något, och till när.
  responsibleMemberId String?
  responsible         Member?   @relation("AgendaItemResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  dueAt               DateTime?

  /// Rader som skrivs automatiskt vid punkten: närvaro och sekreterarbyte,
  /// t.ex. "Anna Andersson lämnade mötet kl. 19.40. Erik Berg utsågs till
  /// sekreterare för resten av mötet." De ändras utan att version ökar, så
  /// att de aldrig krockar med sekreterarens text.
  autoNotes String[] @default([])

  /// Den som senast skrev i punkten. Namnet sparas som text.
  writtenByMemberId String?
  writtenBy         Member? @relation("AgendaItemWriter", fields: [writtenByMemberId], references: [id], onDelete: SetNull)
  writtenByName     String  @default("")
  version           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, meetingId, sortOrder])
}

/// En justering av ett protokoll: en rad per person och uppdrag. Raden skapas
/// när protokollet skickas för justering och fylls i när personen justerat.
/// Protokollet låses när alla rader är justerade.
model ProtocolSignature {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Namnet som det står under protokollet.
  name     String
  role     MeetingRole

  /// Null tills personen justerat.
  method      SignatureMethod?
  signedAt    DateTime?
  /// sha256 för PDF:en som justerades. Ska stämma med mötets protocolSha256 –
  /// annars har protokollet ändrats efteråt.
  pdfSha256   String?
  /// Signeringstjänstens referens (BankID, Freja).
  providerRef String?
  /// Underlaget för underskriften: IP, enhet, vart engångskoden skickades,
  /// eller tjänstens svar.
  evidence    Json?

  /// Engångskoden vid justering i appen. Bara sha256, kort giltighet och ett
  /// begränsat antal försök.
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)

  createdAt DateTime @default(now())

  @@unique([meetingId, memberId, role])
  @@index([associationId, meetingId])
}

/// En kontakt i föreningens register: underleverantörer, förvaltare, jour och
/// andra som hjälper föreningen. Ersätter underleverantörsfälten på
/// MaintenanceCategory.
model Contact {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Det som visas i listan: företaget, eller personen om det inte är ett
  /// företag.
  name             String
  /// Kontaktperson hos företaget. Tom = ingen särskild.
  contactPerson    String      @default("")
  type             ContactType @default(leverantor)
  phone            String      @default("")
  email            String      @default("")
  /// Avtal, kundnummer, öppettider, hur man beställer.
  info             String      @default("")
  /// Syns för boende i appen, t.ex. jouren. Annars bara för styrelsen.
  visibleToMembers Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories          ContactCategory[]
  boardMatters        BoardMatter[]
  maintenanceRequests MaintenanceRequest[]

  @@index([associationId, type, name])
}

/// Vilka felanmälningskategorier en kontakt hanterar (många-till-många). Egen
/// tabell med associationId, så att kopplingarna scopas som allt annat.
model ContactCategory {
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  contactId  String
  contact    Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  categoryId String
  category   MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contactId, categoryId])
  @@index([associationId, categoryId])
}

/// En telefon som ska få pushnotiser från styrelseappen. Samma telefon har en
/// rad per förening där kontot är medlem.
model DeviceToken {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  expoPushToken String
  platform      DevicePlatform
  createdAt     DateTime       @default(now())
  /// Senast appen bekräftade token. Rader som inte setts på länge kan städas.
  lastSeenAt    DateTime       @default(now())

  @@unique([associationId, expoPushToken])
  @@index([associationId, memberId])
}
